# SKETCH2SHAPE AI - Streamlit Secrets Configuration Example
# To configure a permanent Google Colab TripoSR backend URL without entering it in the UI every time:
# 1. Copy this file to .streamlit/secrets.toml
# 2. Paste your live Cloudflare Tunnel URL below:

TRIPOSR_BACKEND_URL = "https://your-tunnel-name.trycloudflare.com"

