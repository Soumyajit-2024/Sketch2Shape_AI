{
  "include": [
    "app",
    "modules",
    "Sketch2Shape_AI"
  ],
  "exclude": [
    "**/node_modules",
    "**/__pycache__",
    ".venv",
    "Sketch2Shape_AI/.venv"
  ],
  "extraPaths": [
    "Sketch2Shape_AI"
